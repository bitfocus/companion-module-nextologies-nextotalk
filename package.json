{
	"name": "nextologies-nextotalk",
	"version": "1.0.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run gen:render-assets && run build:main",
		"gen:render-assets": "node scripts/gen-render-assets.mjs",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "run gen:render-assets && tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-nextologies-nextotalk.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~1.14.1",
		"@resvg/resvg-wasm": "2.6.2",
		"ws": "^8.21.0"
	},
	"devDependencies": {
		"@companion-module/tools": "2.8.0",
		"@types/node": "^22.19.3",
		"@types/ws": "^8.18.1",
		"eslint": "^9.39.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"rimraf": "^6.1.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.51.0",
		"vitest": "^2.1.9"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"npm run lint:raw -- --fix"
		]
	},
	"packageManager": "yarn@4.12.0"
}
